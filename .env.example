# MongoDB connection string. Prisma needs a replica set (Atlas works out of the box).
DATABASE_URL="mongodb+srv://USER:PASS@cluster.mongodb.net/virtualcare?retryWrites=true&w=majority"
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=""
APP_URL="http://localhost:3000"
# Dr. Oparaji's main site; the public pages link back to it. Defaults to https://www.nneomaoparaji.com
NEXT_PUBLIC_PORTFOLIO_URL="https://www.nneomaoparaji.com"

# ── Payments ── mock | test | live
#   mock: test processor for development (card 4000 0000 0000 0002 declines, any other card works)
#   live: Nigeria accounts pay in naira through Paystack; every other account pays in dollars through Stripe.
#   test: same as live, but only test keys (sk_test_…) are accepted, so no real money can move.
# Only SECRET keys go here, and only on the server (never prefix them with NEXT_PUBLIC_).
# Public/publishable keys are not needed: cards are entered on Stripe's and Paystack's own hosted pages.
# Start with "test" and test keys; once a full payment works, switch to "live" and live keys.
PAYMENTS_PROVIDER="mock"

# Stripe → Developers → API keys. Secret key (sk_live_… / sk_test_…), or a restricted key (rk_…), see README.
STRIPE_SECRET_KEY=""
# Stripe → Developers → Webhooks → add endpoint https://YOUR-DOMAIN/api/webhooks/stripe → "Signing secret" (whsec_…)
STRIPE_WEBHOOK_SECRET=""

# Paystack → Settings → API Keys & Webhooks. Secret key (sk_live_… / sk_test_…).
# On the same page set the Webhook URL to https://YOUR-DOMAIN/api/webhooks/paystack (signed with this key).
PAYSTACK_SECRET_KEY=""

# ── Email ── console (prints to the terminal) | smtp | resend
EMAIL_PROVIDER="console"
# Hostinger: hPanel → Emails → your mailbox. Use the full mailbox address and its password.
SMTP_HOST="smtp.hostinger.com"
# 465 = SSL (recommended). 587 = STARTTLS.
SMTP_PORT="465"
SMTP_USER="care@yourdomain.com"
SMTP_PASS=""
# Must use the same address as SMTP_USER (Hostinger rejects other senders).
EMAIL_FROM="Dr. Oparaji · Virtual Care <care@yourdomain.com>"
# Optional: where replies go, if not the sending mailbox.
EMAIL_REPLY_TO=""
RESEND_API_KEY=""

# ── Video ── p2p (built in, no account needed) | daily
VIDEO_PROVIDER="p2p"
# Recommended for p2p: a TURN relay so calls also connect on strict networks.
# Cloudflare (dash.cloudflare.com → Realtime, formerly Calls → TURN → create a key): key ID + API token.
CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_API_TOKEN=""
# …or any other TURN server with fixed credentials (comma-separated URLs).
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
# Only for VIDEO_PROVIDER=daily
DAILY_API_KEY=""
DAILY_DOMAIN=""

# Protects /api/cron/* (send as Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
